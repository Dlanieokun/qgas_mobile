<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/nav_wrapper" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_wrapper"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/green_base"
            android:layout_width="0dp"
            android:layout_height="70dp"
            app:layout_constraintWidth_percent="0.95"
            android:background="@drawable/nav_base_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"/>

        <View
            android:id="@+id/blue_bar"
            android:layout_width="0dp"
            android:layout_height="55dp"
            app:layout_constraintWidth_percent="0.92"
            android:background="@drawable/nav_blue_inner"
            app:layout_constraintBottom_toBottomOf="@id/green_base"
            app:layout_constraintTop_toTopOf="@id/green_base"
            app:layout_constraintStart_toStartOf="@id/green_base"
            app:layout_constraintEnd_toEndOf="@id/green_base" />

        <LinearLayout
            android:id="@+id/nav_item_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/blue_bar"
            app:layout_constraintTop_toTopOf="@id/blue_bar"
            app:layout_constraintStart_toStartOf="@id/blue_bar"
            app:layout_constraintEnd_toStartOf="@+id/nav_item_center_gas">
            <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_center_gas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/ic_gas" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/blue_bar"
            app:layout_constraintTop_toTopOf="@id/blue_bar"
            app:layout_constraintEnd_toEndOf="@id/blue_bar"
            app:layout_constraintStart_toEndOf="@id/nav_item_center_gas">
            <ImageView android:layout_width="45dp" android:layout_height="45dp" android:src="@drawable/ic_settings" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>